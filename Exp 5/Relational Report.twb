      <column caption='Profit Margin' datatype='real' name='[Calculation_2178781127802880]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Profit]) / SUM([Sales]) * 100' />
      </column>
      <column caption='Sales After Discount' datatype='real' name='[Calculation_2178781128077313]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Sales] * (1 - [Discount])' />
      </column>
      <column caption='Total Sales' datatype='real' name='[Calculation_2178781132984322]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Sales])' />
